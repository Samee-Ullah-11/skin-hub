# Copy to .env and fill in. The app refuses to start if a required value is missing.

# MongoDB Atlas connection string. Use a long random database password: Atlas must allow 0.0.0.0/0
# because Vercel's outgoing IP addresses change.
MONGODB_URI=mongodb+srv://USER:STRONG_PASSWORD@cluster0.xxxxx.mongodb.net/clinics?retryWrites=true&w=majority

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Public URL of the site, no trailing slash. Used in email links, the sitemap and canonical URLs.
APP_URL=http://localhost:3000

# console (development only: prints emails to the terminal), brevo, or resend
EMAIL_PROVIDER=console
# Sender address. Must be a verified sender/domain in Brevo or Resend.
EMAIL_FROM=no-reply@example.com
BREVO_API_KEY=
RESEND_API_KEY=

# Cloudinary (required in production; without it uploads are disabled locally)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/daily. Required in production.
CRON_SECRET=

# Used only by `npm run seed` to create the first admin account (password at least 12 characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
